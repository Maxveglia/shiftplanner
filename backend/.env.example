# Runtime DB connection (RESTRICTED role, NOSUPERUSER, RLS applies)
APP_DATABASE_URL=postgresql+psycopg://app_user:app_pass@localhost:5432/shiftplanner
# Admin DB connection (superuser, only used by Alembic / DDL)
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shiftplanner

JWT_SECRET=change-me-dev-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173

# Enables the Claude-powered natural-language intake (/schedule/interpret).
# Without it the frontend silently falls back to its local parser.
ANTHROPIC_API_KEY=

# Enables the opening interview (/interview/*): a few questions about the
# business, asked by Gemini on its free tier, that come back as a brief for
# Claude. Without it the frontend simply does not offer it. Free tier means
# Google may train on what is sent, so the interview is about the business
# and never about a named person -- see app/services/interview.py.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Back office -------------------------------------------------------------
# Trial length granted to every organization on signup.
TRIAL_PERIOD_DAYS=14
# Credentials for the FIRST platform-admin account, read only by
# `make backend-bootstrap-admin`. There is no public signup for the back
# office: that account can see every customer. Minimum 12 characters.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- The business assistant (Claude Managed Agents, beta) ---------------------
# A chat on the manager's dashboard that remembers the business between
# conversations. Needs ANTHROPIC_API_KEY and the two ids printed when the agent
# and the environment are created from backend/assistant/*.yaml (once, by
# hand: the header of backend/assistant/agent.yaml). Off, or either id missing, and the
# assistant does not exist -- no screen, no endpoint, no call.
ASSISTANT_ENABLED=false
ASSISTANT_AGENT_ID=
ASSISTANT_ENVIRONMENT_ID=
