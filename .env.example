# =============================================================================
# ShiftPlanner -- variables de entorno de ejemplo (Fase 0)
# =============================================================================
# Copia los bloques relevantes a los ficheros .env reales:
#   - Backend:  backend/.env
#   - Frontend: frontend/.env
# Nunca comitees los .env reales (estan en .gitignore).

# -----------------------------------------------------------------------------
# BACKEND (backend/.env) -- leido por pydantic-settings
# -----------------------------------------------------------------------------

# URL de runtime: rol RESTRINGIDO (NOSUPERUSER). Sobre este rol aplica RLS.
# Usado por FastAPI/SQLAlchemy en cada request.
APP_DATABASE_URL=postgresql+psycopg://app_user:app_pass@localhost:5432/shiftplanner

# URL de administracion: superusuario. Solo para Alembic (DDL) y seeds globales.
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shiftplanner

# Contrasena del rol restringido app_user, sobre el que se aplica RLS. La
# migracion inicial la sella en el rol en cada `alembic upgrade head`, asi que
# es la de verdad aunque APP_DATABASE_URL traiga otra.
APP_DB_PASSWORD=app_pass

# Firma de JWT. CAMBIA el secreto en cualquier entorno que no sea local.
JWT_SECRET=change-me-dev-secret

# OJO: los dos valores de arriba estan PUBLICADOS en este fichero. Si la base
# de datos no esta en esta misma maquina y siguen con su valor por defecto, la
# app se NIEGA A ARRANCAR con un error que dice cual falta -- antes arrancaba
# igual y firmaba tokens con un secreto que cualquiera puede leer en el repo.
# Si tu Postgres de verdad vive en la misma maquina y quieres saltartelo:
ALLOW_PUBLISHED_DEFAULTS=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origenes permitidos por CORS (coma-separados). El frontend Vite corre en 5173.
CORS_ORIGINS=http://localhost:5173

# --- Back office (la vista del dueno de la plataforma) -----------------------
# Dias de prueba que recibe cada organizacion nueva al registrarse.
TRIAL_PERIOD_DAYS=14

# Credenciales de la PRIMERA cuenta de back office. Solo las lee el comando
# `make backend-bootstrap-admin`; no existe registro publico para el back
# office porque esa cuenta ve a todos los clientes. Minimo 12 caracteres.
# Dejalas vacias en cualquier entorno donde no acabes de instalar.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# FRONTEND (frontend/.env) -- leido por Vite (prefijo VITE_)
# -----------------------------------------------------------------------------

# Base URL del backend FastAPI.
VITE_API_BASE_URL=http://localhost:8000

# --- AI intake (optional) ----------------------------------------------------
# Enables the Claude-powered natural-language intake at POST /schedule/interpret,
# which compiles the manager's spoken/typed brief into a validated scheduling
# spec. Without it the frontend silently falls back to its local parser.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Planning as a job (optional) --------------------------------------------
# Generating a calendar is a queued job worked by background threads in this
# same container, so closing the browser no longer throws away months that have
# already been billed. This is how many it plans at once -- a ceiling, not a
# target. Set it to 0 to run an instance that serves requests and plans nothing.
GENERATION_WORKERS=2

# Seconds a job may go without a heartbeat before another worker may resume it.
# A redeploy mid-generation is the case this exists for.
GENERATION_STALE_AFTER_SECONDS=300

# --- The law, at the moment of publishing ------------------------------------
# Whether POST /schedule/publish REFUSES a rota that breaks a statutory rule
# (daily hours, rest between shifts, weekly rest, night average) or merely logs
# what it would have refused. Off on purpose: the browser judges with the
# figures in the brief and the server judges with the ones in the jurisdiction
# tables, so read the log for a fortnight before turning this on.
PUBLISH_LAW_ENFORCED=false

# --- What the browser is allowed to load -------------------------------------
# Whether the FULL Content-Security-Policy is enforced or only reported.
#
# Off does not mean absent. The half that cannot break a page that already
# works -- base-uri, object-src, frame-ancestors, form-action -- is enforced
# either way. The half that decides where scripts, styles, fonts and XHR may
# come from goes out as Content-Security-Policy-Report-Only: the identical
# string, so what you switch on is exactly what you have been watching. The
# app itself was walked with it enforced and reported nothing; see
# app/security_headers.py.
#
# Two things to settle before setting this to true. /docs and /redoc render a
# blank page under it, because Swagger UI loads its bundle from a CDN and
# styles it inline -- the answer to that is almost certainly not to widen the
# policy. And nothing collects the reports, so the rehearsal is only worth
# what somebody saw with the console open.
CSP_ENFORCED=false
